amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

local productJs = List(
  "src/**/*.ts",
  "addon/**/*.js",
  "scripts/**/*.mjs",
  "typings/global.d.ts",
  "zotero-plugin.config.ts",
)

local evidence = List(
  "node_modules/**",
  ".scaffold/**",
  ".local-test/**",
  "package-lock.json",
)

// Vendored license and notice text is verbatim upstream; it cannot be edited
// to satisfy a spellchecker. This exclusion applies to check and fix modes.
local typosExclude = evidence + List("addon/notices/**")

local fast = new Mapping<String, Step> {
  ["oxlint"] = (Builtins.ox_lint) {
    glob = productJs
  }
  ["shellcheck"] = Builtins.shellcheck
  ["typos"] = (Builtins.typos) {
    exclude = typosExclude
  }
  ["jactionlint"] = Builtins.jactionlint
  ["betterleaks"] = (Builtins.betterleaks) {
    exclude = List("node_modules/**", ".scaffold/**", ".local-test/**", "package-lock.json")
  }
  ["agnix"] {
    glob = List("AGENTS.md", "docs/agents/**/*.md")
    check = "agnix --strict {{files}}"
  }
  ["review-dates"] {
    glob = List("scripts/**/*.py", "scripts/**/*.sh", "src/**", "addon/**")
    check = "scripts/check-review-dates.sh"
  }
  ["versions"] {
    glob = List("mise.toml", "package.json", "scripts/check-versions.sh")
    check = "scripts/check-versions.sh"
  }
}

local slow = (fast) {
  ["typecheck"] {
    glob = List("src/**/*.ts", "typings/**/*.ts", "tsconfig.json", "package.json")
    check = "node_modules/.bin/tsc --noEmit -p tsconfig.json"
  }
  ["generated"] {
    glob = List(
      "addon/**",
      "src/**/*.ts",
      "src/test-fixtures/**",
      "LICENSE",
      "package.json",
      "typings/prefs.d.ts",
      "typings/i10n.d.ts",
      "zotero-plugin.config.ts",
      "scripts/check-distribution.py",
    )
    check = "npm run build --silent && git diff --exit-code -- typings/prefs.d.ts typings/i10n.d.ts && scripts/check-distribution.py"
  }
  ["unit"] {
    glob = List("src/**/*.ts", "src/test-fixtures/**", "scripts/**/*.mjs", ".github/workflows/release.yml", "hk.pkl")
    check = "node --test src/*.test.ts scripts/*.test.mjs"
  }
}

hooks {
  ["pre-commit"] {
    steps = fast
  }
  ["pre-push"] {
    steps = slow
  }
  ["check"] {
    steps = slow
  }
  ["fix"] {
    fix = true
    steps {
      ["oxlint"] = (Builtins.ox_lint) {
        glob = productJs
      }
      ["typos"] = (Builtins.typos) {
        exclude = typosExclude
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "node_modules/.bin/commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
